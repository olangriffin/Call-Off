# Application
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=postgresql+psycopg://user:password@host/database?sslmode=require
APP_BASE_URL=http://127.0.0.1:8000
TRUSTED_HOSTS=127.0.0.1,localhost,testserver

# Public identity and privacy
CONTACT_EMAIL=hello@calloff.ie
LEGAL_ENTITY_NAME=Replace with the legal entity operating Call-Off
PRIVACY_RETENTION_DAYS=365

# Existing authentication integration
NEON_AUTH_BASE_URL=https://replace-with-neon-auth-host
AUTH_COOKIE_SECURE=false
ALLOW_PUBLIC_REGISTRATION=false

# Early-access abuse protection
IP_HASH_SECRET=replace-with-at-least-32-random-characters
EARLY_ACCESS_RATE_LIMIT=5
EARLY_ACCESS_RATE_WINDOW_MINUTES=60
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional SMTP notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
EARLY_ACCESS_NOTIFICATION_EMAIL=
